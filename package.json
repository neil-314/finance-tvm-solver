    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "oxlint": "^1.79.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
